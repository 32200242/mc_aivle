# 로컬 앱 기본 설정
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8100/api/v1
APP_ENV=development
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
AUTH_SECRET=change-this-before-deployment
# 비워 두면 backend/data/counseling_demo.sqlite3 사용
COUNSELING_DATA_PATH=

# 로컬 OCR
OCR_PROVIDER=paddleocr_vl_http
INTERNAL_OCR_URL=https://your-colab-url.ngrok-free.dev/v1/ocr
INTERNAL_OCR_API_KEY=replace-with-colab-api-key
OCR_REQUEST_TIMEOUT=300
OCR_HEALTH_TIMEOUT=12
OCR_REMOTE_BATCH_SIZE=4
PADDLE_OCR_MODEL_ID=PaddlePaddle/PaddleOCR-VL-1.6
PADDLE_OCR_MAX_NEW_TOKENS=512
OCR_MAX_FILE_MB=12
OCR_MAX_PDF_PAGES=12

# 선택적 로컬 믿:음 폴백
MIDM_MODEL_ID=K-intelligence/Midm-2.0-Base-Instruct
MIDM_HF_TOKEN=
MIDM_USE_4BIT=true
MIDM_TRUST_REMOTE_CODE=true
LLM_MAX_OUTPUT_TOKENS=1600

# Colab A100 통합 서버 - 마지막 Colab 셀의 블록으로 이 구역만 교체
AI_PROVIDER=mock
INTERNAL_LLM_BASE_URL=
INTERNAL_LLM_MODEL=K-intelligence/Midm-2.0-Base-Instruct
INTERNAL_LLM_API_KEY=
LLM_REQUEST_TIMEOUT=180
LLM_HEALTH_TIMEOUT=8

AVATAR_PROVIDER=static_2d
# 전용 GPU 워커를 실제로 운영할 때만 longcat_http로 변경합니다.
LONGCAT_AVATAR_BASE_URL=
LONGCAT_AVATAR_API_KEY=
LONGCAT_AVATAR_REQUEST_TIMEOUT=1800

INTERNAL_TTS_URL=
INTERNAL_TTS_API_KEY=
TTS_REQUEST_TIMEOUT=180

STT_PROVIDER=qwen_http
INTERNAL_STT_URL=
INTERNAL_STT_API_KEY=
STT_REQUEST_TIMEOUT=120
STT_HEALTH_TIMEOUT=8
